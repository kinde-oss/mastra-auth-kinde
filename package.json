{
  "name": "@kinde-oss/mastra-auth-kinde",
  "version": "0.1.0",
  "description": "Kinde authentication provider for the Mastra AI agent framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup --silent --config tsup.config.ts",
    "build:watch": "tsup --watch --silent --config tsup.config.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "jose": "^6.2.1"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.32.0-0 <2.0.0-0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mastra/core": "^1.32.0",
    "@types/node": "22.19.15",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.6.0",
    "hono": "^4.12.8",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.0.0"
  },
  "homepage": "https://github.com/kinde-oss/mastra-auth-kinde#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinde-oss/mastra-auth-kinde.git"
  },
  "bugs": {
    "url": "https://github.com/kinde-oss/mastra-auth-kinde/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
